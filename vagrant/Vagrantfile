Vagrant.configure("2") do |config|
  # Ubuntu Server base image
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"
  config.vm.hostname = "petboarding-auto"

  # Forward Windows port 8084 to Ubuntu port 8082
  config.vm.network "forwarded_port",
    guest: 8082,
    host: 8084,
    host_ip: "127.0.0.1"

  # VirtualBox resource configuration
  config.vm.provider "virtualbox" do |vb|
    vb.name = "PetBoardingAutomated"
    vb.memory = 2048
    vb.cpus = 2
  end

  # Application provisioning (script created next)
  config.vm.provision "shell",
    path: "provision.sh"
end
